{
  "appId": "com.buetracker.app",
  "productName": "BUETracker",
  "copyright": "Copyright © 2026 BUET Students",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "extraFiles": [
    {
      "from": "node_modules/electron/dist",
      "to": ".",
      "filter": [
        "icudtl.dat",
        "resources.pak",
        "chrome_100_percent.pak",
        "chrome_200_percent.pak",
        "snapshot_blob.bin",
        "v8_context_snapshot.bin",
        "electron_wer.dll",
        "vulkan-1.dll",
        "vk_swiftshader_icd.json"
      ]
    },
    {
      "from": "node_modules/electron/dist/locales",
      "to": "locales"
    }
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  }
}
